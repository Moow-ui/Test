# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 빌드 때 data/ 에서 만드는 정적 문제 파일 (scripts/build-data.ts)
/public/data/

# 빌드 때 NEXT_PUBLIC_ADSENSE_ID 로 만드는 파일 (scripts/build-ads-txt.ts)
/public/ads.txt

# 빌드 때 config/indexnow.ts 의 키로 만드는 IndexNow 키 파일 (scripts/build-indexnow-key.ts)
/public/*.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare (OpenNext 빌드 결과)
/.open-next/
/.wrangler/
.dev.vars
