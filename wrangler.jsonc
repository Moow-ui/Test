{
  // Cloudflare Workers 배포 설정 (OpenNext 로 Next.js 를 Workers 에서 실행)
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare 대시보드의 Worker 이름과 같아야 한다
  "name": "test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // `npx wrangler deploy` 만 실행해도 먼저 사이트를 빌드하도록 한다
  // (Cloudflare 의 Build command 가 비어 있어도 배포가 된다)
  //  1) build: Next.js 를 빌드해 Workers 용으로 묶는다
  //  2) populateCache: 빌드 때 미리 만들어 둔 페이지(HTML)를 배포 파일에 넣는다.
  //     이 단계가 빠지면 모든 페이지가 404/500 이 된다
  "build": {
    "command": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare populateCache local"
  },
  // 회원 정보·기록을 저장하는 DB (Cloudflare D1).
  // database_id 를 적지 않으면 배포할 때 Cloudflare 가 DB 를 자동으로 만들어 연결한다.
  // 표(테이블)는 사이트가 처음 쓸 때 스스로 만든다 (lib/server/db.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qpass"
    }
  ],
  "observability": {
    "enabled": true
  }
}
