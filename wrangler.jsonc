{
  // Cloudflare Workers 배포 설정 (OpenNext 로 Next.js 를 Workers 에서 실행)
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare 대시보드의 Worker 이름과 같아야 한다
  "name": "test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 빌드는 여기서 하지 않는다.
  // Cloudflare 에서는 설치 직후 scripts/ci-build.mjs 가 `opennextjs-cloudflare build` 를 실행하고,
  // 그다음 `npx wrangler deploy` → `opennextjs-cloudflare deploy` 가 미리 만든 페이지를 배포 파일에 넣어 올린다.
  // 내 컴퓨터에서 직접 올릴 때는 `npm run deploy`.
  // 회원 정보·기록을 저장하는 DB (Cloudflare D1).
  // database_id 를 적지 않으면 배포할 때 Cloudflare 가 DB 를 자동으로 만들어 연결한다.
  // 표(테이블)는 사이트가 처음 쓸 때 스스로 만든다 (lib/server/db.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qpass"
    }
  ],
  // 관리자 화면(/admin) 잠금에 쓰는 값 CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD 는
  // Cloudflare 대시보드(Worker → 설정 → 변수 및 비밀)에 넣는다. 배포해도 그 값이 지워지지 않게 한다.
  // 두 값이 없으면 /admin 은 아무도 열 수 없다 (lib/server/access.ts).
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
