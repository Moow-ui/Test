# 내 컴퓨터에서는 이 파일을 .env.local 로 복사해서 쓰고,
# 배포할 때는 Cloudflare 대시보드 → Workers & Pages → test → Settings → Build → Variables and secrets 에 같은 이름으로 넣으세요.
# 모든 페이지가 빌드 때 만들어지므로, 값을 넣거나 바꾼 뒤에는 다시 배포해야 반영됩니다.

# 실제 사이트 주소 (끝에 / 없이). canonical, sitemap.xml, OG 이미지 주소에 쓰입니다.
NEXT_PUBLIC_SITE_URL=https://example.com

# 문의 이메일. 기본값은 lib/site.ts 에 적혀 있습니다. 여기에 넣으면 이 값이 우선합니다.
CONTACT_EMAIL=

# 검색엔진 소유확인 값 (HTML 태그 방식의 content="..." 안에 있는 값만)
# 네이버 값은 lib/site.ts 에 이미 적혀 있습니다. 여기에 넣으면 이 값이 우선합니다.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# 구글 애드센스 게시자 ID (예: ca-pub-1234567890123456).
# 있으면 광고가 표시되고 /ads.txt 에 한 줄이 생깁니다. 없으면 광고 영역이 아예 나오지 않고 ads.txt 는 빈 파일입니다.
NEXT_PUBLIC_ADSENSE_ID=

# 1 로 두면 광고 ID 가 없어도 광고가 들어갈 자리를 점선 상자로 미리 보여 줍니다.
NEXT_PUBLIC_SHOW_AD_SLOTS=
