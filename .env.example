# 내 컴퓨터에서는 이 파일을 .env.local 로 복사해서 쓰고,
# 배포할 때는 Cloudflare 대시보드 → Workers & Pages → test → Settings → Build → Build variables 에 같은 이름으로 넣으세요.

# 실제 사이트 주소 (끝에 / 없이). canonical, sitemap.xml, OG 이미지 주소에 쓰입니다.
NEXT_PUBLIC_SITE_URL=https://example.com

# 구글 서치콘솔 소유확인 값 (HTML 태그 방식의 content="..." 안에 있는 값만)
GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 소유확인 값 (HTML 태그 방식의 content="..." 안에 있는 값만)
NAVER_SITE_VERIFICATION=

# 1 로 두면 나중에 광고가 들어갈 자리를 점선 상자로 미리 보여 줍니다. (실제 광고는 아직 없음)
NEXT_PUBLIC_SHOW_AD_SLOTS=
